<!DOCTYPE html>
<html lang="ms">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<title>Hairiamri — Servis Buat Landing Page RM99</title>
<meta name="description" content="Servis buat landing page cantik & murah. RM99 sahaja, siap 3-5 hari. Domain, hosting, SSL semua included.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,300..900;1,14..32,300..900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --color-prism-teal: #14b8a6;
    --color-deep-teal: #0d9488;
    --color-carbon-ink: #1d242f;
    --color-graphite: #111827;
    --color-slate: #6b7280;
    --color-steel: #718096;
    --color-fog: #9ca3af;
    --color-mist: #e2e8f0;
    --color-bone: #f3f4f6;
    --color-paper: #ffffff;

    --font-sans: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif;
    --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;

    --page-max: 1200px;
    --section-gap: 80px;
    --card-padding: 24px;

    --radius-md: 6px;
    --radius-lg: 10px;

    --shadow-subtle: rgba(0, 0, 0, 0.04) 0 1px 2px 0;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    font-family: var(--font-sans);
    font-feature-settings: "cv01", "cv02", "cv06", "cv07", "cv08", "cv10";
    color: var(--color-graphite);
    background: var(--color-paper);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    line-height: 1.5;
    letter-spacing: 0.02em;
  }

  a { color: inherit; text-decoration: none; }
  img { max-width: 100%; display: block; }

  /* =========================================
     NAVIGATION
     ========================================= */
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-mist);
    box-shadow: var(--shadow-subtle);
  }

  .nav-inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 24px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .nav-brand img {
    width: 28px;
    height: 28px;
    border-radius: var(--radius-md);
    object-fit: cover;
  }

  .nav-brand span {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: -0.01em;
    color: var(--color-carbon-ink);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
    flex: 1;
    justify-content: center;
  }

  .nav-links a {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-carbon-ink);
    padding: 8px 12px;
    border-radius: var(--radius-md);
    transition: background .15s ease;
    letter-spacing: 0.02em;
  }

  .nav-links a:hover { background: var(--color-bone); }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--color-prism-teal);
    color: var(--color-paper);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 9px 16px;
    border-radius: var(--radius-md);
    transition: background .15s ease;
    flex-shrink: 0;
  }
  .nav-cta:hover { background: var(--color-deep-teal); }
  .nav-cta svg { width: 14px; height: 14px; }

  .nav-toggle {
    display: none;
    background: transparent;
    border: 1px solid var(--color-mist);
    border-radius: var(--radius-md);
    padding: 8px 10px;
    cursor: pointer;
  }

  @media (max-width: 768px) {
    .nav-links { display: none; }
    .nav-toggle { display: flex; align-items: center; justify-content: center; }
    .nav-brand span { font-size: 14px; }
  }

  /* =========================================
     HERO
     ========================================= */
  .hero {
    padding: 104px 24px 80px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 1200px;
    height: 500px;
    background: radial-gradient(ellipse at top, rgba(20, 184, 166, 0.08) 0%, transparent 60%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-inner {
    max-width: var(--page-max);
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--color-paper);
    border: 1px solid var(--color-mist);
    border-radius: 999px;
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-slate);
    letter-spacing: 0.02em;
    margin-bottom: 28px;
    box-shadow: var(--shadow-subtle);
  }

  .hero-badge .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-prism-teal);
  }

  .hero-title {
    font-family: var(--font-sans);
    font-weight: 900;
    font-size: clamp(40px, 7vw, 72px);
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--color-carbon-ink);
    margin-bottom: 24px;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-title .accent {
    font-style: italic;
    font-weight: 300;
    letter-spacing: -0.03em;
  }

  .hero-title .teal-text {
    color: var(--color-prism-teal);
  }

  .hero-sub {
    font-size: 18px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: var(--color-slate);
    max-width: 620px;
    margin: 0 auto 40px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--color-prism-teal);
    color: var(--color-paper);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 12px 20px;
    border-radius: var(--radius-md);
    transition: background .15s ease, transform .15s ease;
    border: none;
    cursor: pointer;
    font-family: inherit;
  }
  .btn-primary:hover { background: var(--color-deep-teal); }
  .btn-primary svg { width: 16px; height: 16px; }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--color-paper);
    color: var(--color-graphite);
    font-size: 16px;
    font-weight: 500;
    padding: 12px 16px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-mist);
    transition: border-color .15s ease, background .15s ease;
    cursor: pointer;
    font-family: inherit;
  }
  .btn-ghost:hover { background: var(--color-bone); }
  .btn-ghost .cmd {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--color-graphite);
    font-weight: 400;
  }
  .btn-ghost .prompt { color: var(--color-slate); }
  .btn-ghost svg { width: 14px; height: 14px; color: var(--color-fog); }

  /* =========================================
     SECTION
     ========================================= */
  .section {
    padding: var(--section-gap) 24px;
  }

  .section-inner {
    max-width: var(--page-max);
    margin: 0 auto;
  }

  .section-head {
    text-align: center;
    margin-bottom: 48px;
  }

  .section-eyebrow {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-prism-teal);
    margin-bottom: 12px;
  }

  .section-title {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: clamp(28px, 4vw, 40px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-carbon-ink);
    margin-bottom: 12px;
  }

  .section-sub {
    font-size: 17px;
    font-weight: 400;
    line-height: 1.5;
    color: var(--color-slate);
    max-width: 560px;
    margin: 0 auto;
    letter-spacing: 0.02em;
  }

  /* =========================================
     FEATURES GRID
     ========================================= */
  .features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .feature {
    background: var(--color-paper);
    border: 1px solid var(--color-mist);
    border-radius: var(--radius-lg);
    padding: var(--card-padding);
    box-shadow: var(--shadow-subtle);
    transition: border-color .2s ease;
  }

  .feature:hover { border-color: var(--color-fog); }

  .feature-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: var(--color-bone);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    color: var(--color-prism-teal);
  }
  .feature-icon svg { width: 18px; height: 18px; }

  .feature-title {
    font-size: 17px;
    font-weight: 600;
    color: var(--color-carbon-ink);
    letter-spacing: -0.01em;
    margin-bottom: 8px;
  }

  .feature-desc {
    font-size: 14px;
    font-weight: 400;
    line-height: 1.55;
    color: var(--color-slate);
    letter-spacing: 0.02em;
  }

  .feature-preview {
    margin-top: 16px;
    background: var(--color-bone);
    border: 1px solid var(--color-mist);
    border-radius: var(--radius-md);
    padding: 10px 12px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-graphite);
    line-height: 1.6;
  }
  .feature-preview .cmd-prompt { color: var(--color-slate); }
  .feature-preview .cmd-line { color: var(--color-graphite); }
  .feature-preview .cmd-accent { color: var(--color-prism-teal); }

  @media (max-width: 900px) {
    .features { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .features { grid-template-columns: 1fr; }
  }

  /* =========================================
     HOW IT WORKS
     ========================================= */
  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .step {
    border-top: 2px solid var(--color-carbon-ink);
    padding-top: 20px;
    position: relative;
  }

  .step:first-child { border-color: var(--color-prism-teal); }

  .step-num {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-slate);
    margin-bottom: 12px;
    letter-spacing: 0.05em;
  }

  .step-title {
    font-size: 17px;
    font-weight: 600;
    color: var(--color-carbon-ink);
    letter-spacing: -0.01em;
    margin-bottom: 8px;
  }

  .step-desc {
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-slate);
    letter-spacing: 0.02em;
  }

  @media (max-width: 768px) {
    .steps { grid-template-columns: 1fr 1fr; gap: 24px; }
  }
  @media (max-width: 480px) {
    .steps { grid-template-columns: 1fr; }
  }

  /* =========================================
     PRICING
     ========================================= */
  .pricing {
    max-width: 480px;
    margin: 0 auto;
  }

  .price-card {
    background: var(--color-paper);
    border: 1px solid var(--color-mist);
    border-radius: var(--radius-lg);
    padding: 40px 32px;
    text-align: left;
    box-shadow: var(--shadow-subtle);
    position: relative;
    overflow: hidden;
  }

  .price-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--color-prism-teal);
  }

  .price-label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-slate);
    margin-bottom: 16px;
  }

  .price-amount {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 8px;
  }

  .price-amount .currency {
    font-size: 24px;
    font-weight: 500;
    color: var(--color-carbon-ink);
  }

  .price-amount .value {
    font-family: var(--font-sans);
    font-size: 64px;
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-carbon-ink);
  }

  .price-note {
    font-size: 14px;
    color: var(--color-slate);
    margin-bottom: 32px;
    letter-spacing: 0.02em;
  }

  .price-list {
    list-style: none;
    margin-bottom: 32px;
  }

  .price-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 10px 0;
    font-size: 15px;
    color: var(--color-graphite);
    letter-spacing: 0.02em;
    border-bottom: 1px solid var(--color-bone);
  }
  .price-list li:last-child { border-bottom: none; }

  .price-list .check {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: rgba(20, 184, 166, 0.12);
    color: var(--color-prism-teal);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .price-list .check svg { width: 10px; height: 10px; }

  .price-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    background: var(--color-prism-teal);
    color: var(--color-paper);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 14px 20px;
    border-radius: var(--radius-md);
    transition: background .15s ease;
  }
  .price-cta:hover { background: var(--color-deep-teal); }
  .price-cta svg { width: 16px; height: 16px; }

  /* =========================================
     TESTIMONIALS
     ========================================= */
  .testimonials {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .testimonial {
    background: transparent;
  }

  .testimonial-quote {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-carbon-ink);
    letter-spacing: 0.02em;
    margin-bottom: 20px;
  }

  .testimonial-quote em {
    font-style: italic;
    font-weight: 600;
  }

  .testimonial-author {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .testimonial-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--color-bone);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 14px;
    color: var(--color-carbon-ink);
    flex-shrink: 0;
  }

  .testimonial-info .name {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-carbon-ink);
    letter-spacing: -0.005em;
  }

  .testimonial-info .role {
    font-size: 13px;
    color: var(--color-slate);
    letter-spacing: 0.02em;
  }

  @media (max-width: 900px) {
    .testimonials { grid-template-columns: 1fr; gap: 32px; }
  }

  /* =========================================
     FAQ
     ========================================= */
  .faq {
    max-width: 720px;
    margin: 0 auto;
  }

  .faq-item {
    border-bottom: 1px solid var(--color-mist);
    padding: 20px 0;
  }
  .faq-item:first-child { border-top: 1px solid var(--color-mist); }

  .faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    font-size: 16px;
    font-weight: 600;
    color: var(--color-carbon-ink);
    letter-spacing: -0.01em;
    gap: 16px;
  }

  .faq-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--color-slate);
    transition: transform .2s ease;
  }

  .faq-item.open .faq-icon { transform: rotate(45deg); }

  .faq-a {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-slate);
    letter-spacing: 0.02em;
    max-height: 0;
    overflow: hidden;
    transition: max-height .3s ease, padding .3s ease;
    padding-top: 0;
  }

  .faq-item.open .faq-a {
    max-height: 300px;
    padding-top: 12px;
  }

  /* =========================================
     CTA BANNER
     ========================================= */
  .cta-banner {
    max-width: var(--page-max);
    margin: 0 auto;
    background: var(--color-carbon-ink);
    border-radius: var(--radius-lg);
    padding: 64px 40px;
    text-align: center;
    color: var(--color-paper);
    position: relative;
    overflow: hidden;
  }

  .cta-banner::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
  }

  .cta-banner-inner { position: relative; z-index: 1; }

  .cta-title {
    font-family: var(--font-sans);
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
    color: var(--color-paper);
  }

  .cta-sub {
    font-size: 17px;
    color: rgba(255,255,255,0.7);
    margin-bottom: 32px;
    letter-spacing: 0.02em;
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
  }

  /* =========================================
     FOOTER
     ========================================= */
  .footer {
    border-top: 1px solid var(--color-mist);
    padding: 48px 24px 32px;
    margin-top: 80px;
  }

  .footer-inner {
    max-width: var(--page-max);
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .footer-brand img {
    width: 24px;
    height: 24px;
    border-radius: 5px;
  }
  .footer-brand span {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-carbon-ink);
  }

  .footer-links {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }
  .footer-links a {
    font-size: 14px;
    color: var(--color-slate);
    letter-spacing: 0.02em;
    transition: color .15s ease;
  }
  .footer-links a:hover { color: var(--color-carbon-ink); }

  .footer-copy {
    width: 100%;
    text-align: center;
    font-size: 13px;
    color: var(--color-fog);
    padding-top: 24px;
    margin-top: 24px;
    border-top: 1px solid var(--color-mist);
    letter-spacing: 0.02em;
  }

  /* =========================================
     FLOATING CHAT
     ========================================= */
  .chat-float {
    position: fixed;
    bottom: 24px;
    right: 20px;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-prism-teal);
    color: var(--color-paper);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(20, 184, 166, 0.35);
    z-index: 9998;
    transition: transform .2s ease;
  }
  .chat-float:hover { transform: scale(1.05); }
  .chat-float svg { width: 24px; height: 24px; }

  /* =========================================
     UTILITIES
     ========================================= */
  @media (max-width: 640px) {
    .hero { padding: 72px 20px 60px; }
    .section { padding: 64px 20px; }
    .hero-actions { flex-direction: column; width: 100%; }
    .btn-primary, .btn-ghost { width: 100%; justify-content: center; }
    .cta-banner { padding: 48px 24px; }
  }
</style>
</head>
<body>

  <!-- NAV -->
  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="nav-brand">
        <img src="assets/logoUtama/logoUtama.png" alt="hairiamri.buzz">
        <span>hairiamri.buzz</span>
      </a>

      <div class="nav-links">
        <a href="#features">Servis</a>
        <a href="#how">Proses</a>
        <a href="#pricing">Harga</a>
        <a href="#faq">FAQ</a>
        <a href="/blog.html">Blog</a>
      </div>

      <a href="https://wa.me/60172131814" target="_blank" class="nav-cta">
        Tempah Sekarang
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </nav>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-badge">
        <span class="dot"></span>
        <span>Siap 3-5 hari · Domain + hosting included</span>
      </div>

      <h1 class="hero-title">
