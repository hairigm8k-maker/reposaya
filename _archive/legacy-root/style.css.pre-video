/* ============================================
   BLOG LIST — Card Bucu Tajam (FINAL)
   ============================================ */
.section-blog {
  padding: 30px 20px 80px;
  max-width: 720px;
  margin: 0 auto;
}

.blog-title {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 36px;
  font-weight: 700;
  color: #1a1a1a;
  letter-spacing: -1px;
  line-height: 1.1;
  margin: 0 0 8px 0;
}

.blog-sub {
  font-family: 'Inter', sans-serif;
  font-size: 15px;
  color: #888;
  line-height: 1.5;
  margin: 0 0 32px 0;
  padding-bottom: 20px;
  border-bottom: 1px solid #e5e5e5;
}

.blog-grid {
  display: flex;
  flex-direction: column;
  gap: 20px;
  margin-bottom: 40px;
}

.blog-card {
  display: block;
  padding: 26px 24px;
  background-color: #ffffff;
  border: 1px solid #e5e5e5;
  border-radius: 0;
  text-decoration: none;
  transition: 0.25s;
  position: relative;
}

.blog-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 0;
  background-color: #E31E24;
  transition: width 0.3s;
}

.blog-card:hover {
  border-color: #1a1a1a;
  transform: translateX(4px);
}

.blog-card:hover::before {
  width: 4px;
}

.blog-card h2 {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 19px;
  font-weight: 700;
  color: #1a1a1a;
  letter-spacing: -0.3px;
  line-height: 1.35;
  margin: 0 0 10px 0;
  text-decoration: none;
}

.blog-card p {
  font-family: 'Inter', sans-serif;
  font-size: 14px;
  color: #666;
  line-height: 1.6;
  margin: 0 0 14px 0;
  text-decoration: none;
}

.blog-card-link {
  font-family: 'Inter', sans-serif;
  font-size: 13px;
  font-weight: 600;
  color: #E31E24;
  text-decoration: none;
}

.blog-card,
.blog-card * {
  text-decoration: none;
}

.blog-back {
  display: inline-block;
  padding: 12px 24px;
  background-color: #1a1a1a;
  color: #ffffff;
  text-decoration: none;
  border-radius: 100px;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 14px;
  font-weight: 600;
  transition: 0.2s;
}

.blog-back:hover {
  background-color: #333;
  transform: translateY(-2px);
}

@media (min-width: 768px) {
  .section-blog { padding: 60px 40px 100px; }
  .blog-title { font-size: 48px; }
  .blog-card { padding: 32px 28px; }
  .blog-card h2 { font-size: 22px; }
}

.blog-card-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
}

.blog-card-date {
  font-family: 'Inter', sans-serif;
  font-size: 11px;
  color: #999;
  font-weight: 500;
}

.loading-blog {
  text-align: center;
  padding: 40px 20px;
  color: #999;
  font-size: 14px;
}
