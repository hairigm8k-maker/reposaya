/* ============================================
   SECTION — KREDIBILITI
   ============================================ */
.section-kredibiliti {
  padding: 50px 25px;
  text-align: center;
}



@media (max-width: 600px) {
  .section-kredibiliti {
    padding: 40px 20px;
  }
  
}






/* Gradient Move Animation */
.kredibiliti-text {
  font-family: 'Inter', sans-serif;
  font-size: 26px;
  font-weight: 800;
  font-style: italic;
  line-height: 1.3;
  letter-spacing: -0.5px;
  max-width: 340px;
  margin: 0 auto;
  background: linear-gradient(
    90deg,
    #1a1a1a 0%,
    #E31E24 25%,
    #1a1a1a 50%,
    #E31E24 75%,
    #1a1a1a 100%
  );
  background-size: 300% 100%;
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
  animation: gradientMove 6s linear infinite;
}

@keyframes gradientMove {
  0% { background-position: 0% 50%; }
  100% { background-position: 300% 50%; }
}



/* Lens reveal — pastikan hero-big support clip-path */
.hero-big {
  display: flex;
  flex-direction: column;
  line-height: 0.85;
  letter-spacing: -3px;
  margin-bottom: 40px;
  position: relative;
  z-index: 10;
}

/* Goyang subtle untuk featureImg1 */
.hero-feature-img {
  position: absolute;
  left: -40px;
  top: 40px;
  width: 130px;
  height: auto;
  object-fit: contain;
  z-index: 2;
}






/* Scale in untuk featureImg1 */
.hero-feature-img {
  position: absolute;
  left: -40px;
  top: 40px;
  width: 130px;
  height: auto;
  object-fit: contain;
  z-index: 2;
}

@keyframes scaleIn {
  0% {
    opacity: 0;
    transform: scale(0.5);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

/* ============================================
   PROMO MARQUEE — bawah RGB header
   ============================================ */
.promo-marquee {
  background-color: #E31E24;
  color: #ffffff;
  overflow: hidden;
  white-space: nowrap;
  padding: 10px 0;
  position: relative;
}

.promo-track {
  display: inline-block;
  white-space: nowrap;
  animation: promoScroll 15s linear infinite;
}

.promo-item {
  display: inline-block;
  padding-right: 60px;
  font-family: 'Space Grotesk', -apple-system, sans-serif;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  color: #ffffff;
}

.promo-item a {
  color: #ffffff;
  text-decoration: underline;
  text-underline-offset: 3px;
  font-weight: 800;
}

@keyframes promoScroll {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

@media (max-width: 600px) {
  .promo-item { font-size: 12px; padding-right: 50px; }
}


/* ============================================
   BLINK MARQUEE
   ============================================ */
.promo-marquee {
  background-color: #E31E24;
}

.promo-item {
  animation: blinkText 1s step-end infinite;
}

@keyframes blinkText {
  0%, 50% { opacity: 1; }
  51%, 100% { opacity: 0.15; }
}

