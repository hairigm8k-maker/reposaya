* { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Space Grotesk', -apple-system, 'Segoe UI', Roboto, sans-serif; }
body { background-color: #ffffff; color: #1a1a1a; }

/* NAVBAR */
.main-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px 25px;
  background-color: #ffffff;
  border-bottom: 1px solid #e5e5e5;
  height: 70px;
}
.nav-left { display: flex; align-items: center; gap: 25px; }
.hamburger { display: flex; flex-direction: column; gap: 5px; cursor: pointer; }
.hamburger span { width: 26px; height: 2.5px; background-color: #1a1a1a; border-radius: 2px; }
.logo-img { height: 35px; width: auto; object-fit: contain; }
.nav-center { flex: 1; max-width: 450px; margin: 0 25px; }
.search-box { display: flex; align-items: center; background-color: #f5f5f5; padding: 12px 18px; border-radius: 10px; gap: 12px; }
.search-icon { width: 20px; height: 20px; color: #888; flex-shrink: 0; }
.search-box input { border: none; background: transparent; font-size: 15px; outline: none; width: 100%; color: #1a1a1a; font-family: inherit; }
.search-box input::placeholder { color: #999; }
.nav-right { display: flex; align-items: center; }
.datetime-widget { display: flex; flex-direction: column; align-items: flex-end; margin-right: 15px; padding-right: 15px; border-right: 1px solid #e5e5e5; line-height: 1.2; }
.time-display { font-size: 16px; font-weight: 700; color: #1a1a1a; font-variant-numeric: tabular-nums; }
.date-display { font-size: 11px; color: #888; font-weight: 500; margin-top: 2px; white-space: nowrap; }
.profile-icon { width: 28px; height: 28px; color: #1a1a1a; cursor: pointer; }

/* RGB */
.divider-bar { height: 3px; width: 100%; overflow: hidden; }
.rgb-line {
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, #ff0000, #ff7f00, #ffff00, #00ff00, #0000ff, #4b0082, #9400d3, #ff0000);
  background-size: 400% 100%;
  animation: rgbShift 8s linear infinite;
}
@keyframes rgbShift { 0% { background-position: 0% 50%; } 100% { background-position: 400% 50%; } }

/* ===== HERO EDITORIAL ===== */
.hero-editorial {
  position: relative;
  overflow: hidden;
  padding: 40px 25px 20px;
  background-color: #ffffff;
  position: relative;
  min-height: 70vh;
}



.hero-big {
  display: flex;
  flex-direction: column;
  line-height: 0.85;
  letter-spacing: -3px;
  margin-bottom: 40px;
  position: relative;
  z-index: 10;
}

.hero-big span {
  font-size: 68px;
  font-weight: 700;
  color: #1a1a1a;
}

.hero-bottom {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  
  padding-top: 20px;
}

.price-badge {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.price-prefix {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 3px;
  color: #999;
}

.price-value {
  font-size: 48px;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1;
  letter-spacing: -2px;
}

.order-btn {
  background-color: #E31E24;
  color: #ffffff;
  border: none;
  padding: 14px 26px;
  font-family: inherit;
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 1px;
  border-radius: 0;
  cursor: pointer;
  transition: 0.2s;
}
.order-btn:active { opacity: 0.8; }

/* RESPONSIVE */
@media (max-width: 600px) {
  .main-nav { padding: 12px 15px; height: 60px; }
  .nav-left { gap: 15px; }
  .nav-center { margin: 0 12px; }
  .search-box { padding: 8px 12px; }
  .search-box input { font-size: 13px; }
  .logo-img { height: 28px; }
  .hamburger span { width: 22px; }
  .profile-icon { width: 24px; height: 24px; }
  .datetime-widget { margin-right: 10px; padding-right: 10px; }
  .time-display { font-size: 13px; }
  .date-display { font-size: 9px; }

  .hero-editorial { padding: 30px 20px 20px; min-height: 65vh; }
  .hero-big span { font-size: 58px; letter-spacing: -2.5px; }
  .price-value { font-size: 42px; }
  .order-btn { padding: 12px 22px; font-size: 13px; }
}

/* Center hero + buang button */
.hero-editorial { text-align: center; }
.hero-big {
  display: flex;
  flex-direction: column;
  line-height: 0.85;
  letter-spacing: -3px;
  margin-bottom: 40px;
  position: relative;
  z-index: 10;
}
.hero-bottom { justify-content: center; border-top: none; }
.price-badge { align-items: center; }

/* Animasi RM99 */
.price-value em {
  font-style: normal;
  display: inline-block;
  color: #E31E24;
  animation: rm99Anim 1.5s ease-in-out infinite;
}
@keyframes rm99Anim {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.15); }
}

/* Tarik price-badge ke atas */
.hero-bottom {
  margin-top: -20px;
  padding-top: 0;
}

/* Animasi flip 99 */
.price-value em {
  animation: flip99 2s ease-in-out infinite;
  transform-style: preserve-3d;
  perspective: 400px;
}

50%, 90% { transform: rotateX(360deg); }
  100% { transform: rotateX(360deg); }
}

/* Garis sempadan bawah hero section */
.hero-editorial {
  border-bottom: 1px solid #1a1a1a;
}

/* FIX HERO SPACE */
.hero {
    height: auto !important;
    min-height: auto !important;
    padding-bottom: 20px !important;
}


section:first-of-type {
    height: auto !important;
    min-height: auto !important;
    padding-bottom: 20px !important;
}


/* Background hero — tak melepasi garis sempadan */
.hero-editorial {
    background-image: url('assets/background1.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    position: relative;
    overflow: hidden;
    z-index: 1;
}

/* Overlay putih supaya text jelas */
.hero-editorial::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.85);
    z-index: -1;
}

/* Pastikan text atas overlay */
.hero-big,
.hero-bottom {
    position: relative;
    z-index: 2;
}

